# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# Admin Authentication
ADMIN_SECRET=

# Database Configuration
# Required for PostgreSQL connection (e.g., Supabase, Neon, Cloud SQL)
DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# Marketcheck API
MARKETCHECK_API_KEY=
MARKETCHECK_API_SECRET=

# Telegram Integration (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Stripe (use sk_test_... in dev, sk_live_... in prod). NEVER commit a real key.
STRIPE_SECRET_KEY=

# Email / SMS providers (optional, for lead notifications)
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Google Gemini (AI features)
GEMINI_API_KEY=

# Comma-separated list of super-admin emails
SUPER_ADMIN_EMAILS=

# Frontend URL (for CORS and redirects)
FRONTEND_URL=

# Frontend (VITE_*) - exposed to the browser, so use PUBLISHABLE keys only here
VITE_GA_ID=
# Stripe PUBLISHABLE key (pk_...), safe for the client
VITE_STRIPE_PUBLISHABLE_KEY=
# Feature flag: free soft-pull before the $95 deposit (1/true to enable)
VITE_SOFTPULL_FIRST=
